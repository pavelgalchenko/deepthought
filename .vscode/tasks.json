{
    "version": "2.0.0",
    // "command": "bash",
    "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
    },
    "options": {
        "cwd": "${workspaceRoot}",
        "environment": [],
    },
    // "args": [
    //     "-c"
    // ],
    "inputs": [
        {
            "id": "missionName",
            "description": "Choose Mission to run",
            "type": "pickString",
            "options": [
                "Demo",
                "Missions/DSM_DEMO",
                "Missions/DSM_NAV_DEMO"
            ],
            "default": "DSM_DEMO"
        },
        {
            "id": "testTarget",
            "description": "Choose test target to run",
            "type": "pickString",
            "options": [
                "Kit/tests/jdkit_tests",
                "Kit/tests/rationalkit_tests",
            ],
            "default": "Kit/tests/jdkit_tests"
        },
        {
            "id": "testLabel",
            "description": "Choose test to run, empty for all ([suite]/[test])",
            "type": "promptString",
        },
    ],
    "tasks": [
        {
            "label": "release build",
            "type": "cmake",
            "command": "build",
            "preset": "Release-build",
        },
        {
            "label": "relwithdebinfo build",
            "type": "cmake",
            "command": "build",
            "preset": "RelWithDebInfo-build",
        },
        {
            "label": "debug build",
            "type": "cmake",
            "command": "build",
            "preset": "Debug-build",
        },
        {
            "label": "start criterion test",
            "type": "shell",
            "command": [
                "env",
                "-i",
                "bash",
                "--login",
                "-c",
                "'${workspaceFolder}/build/Debug/${input:testTarget} --debug --color=always --filter=${input:testLabel}'"
            ],
            "isBackground": true,
            "problemMatcher": [
                // From https://stackoverflow.com/questions/44242048/how-can-i-prevent-vs-code-from-waiting-for-a-prelaunchtask-to-finish
                // This does nothing, but it is needed to let the calling launch task keep going
                // Thanks vscode.
                {
                    "pattern": [
                        {
                            "regexp": ".",
                            "file": 1,
                            "location": 2,
                            "message": 3
                        }
                    ],
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": ".",
                        "endsPattern": ".",
                    }
                }
            ]
        },
        {
            "label": "build and start criterion test",
            "dependsOn": [
                "debug build",
                "start criterion test"
            ],
            "dependsOrder": "sequence",
        }
        // {
        //     "label": "analyze project",
        //     "type": "shell",
        //     "args": [
        //         "echo",
        //         "${env:LD_PROFILE}",
        //         "&&",
        //         "gprof",
        //         "./deepthought",
        //         "gmon.out",
        //         ">",
        //         "dt_analysis.txt",
        //         "&&",
        //         "sprof",
        //         "./Kit/${config:LD_PROFILE}",
        //         "${config:LD_PROFILE}.profile",
        //         ">",
        //         "kit_analysis.txt"
        //     ]
        // },
    ]
}