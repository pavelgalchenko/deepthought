{
   // Use IntelliSense to learn about possible attributes.
   // Hover to view descriptions of existing attributes.
   // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
   "version": "0.2.0",
   "inputs": [
      {
         "id": "missionName",
         "description": "Choose Mission to run",
         "type": "pickString",
         "options": [
            "Demo",
            "Missions/DSM_DEMO",
            "Missions/DSM_NAV_DEMO",
            "Missions/NESC_Testing/EarthOrbit",
            "Missions/NESC_Testing/LunarOrbit",
         ],
         "default": "DSM_DEMO"
      },
      {
         "id": "arbitraryMission",
         "description": "Choose Mission to run",
         "type": "promptString",
         "default": "${workspaceFolder}/Missions/DSM_DEMO"
      },
      {
         "id": "testTarget",
         "description": "Choose test target to run",
         "type": "pickString",
         "options": [
            "Kit/tests/jdkit_tests",
            "Kit/tests/rationalkit_tests",
         ],
         "default": "Kit/tests/jdkit_tests"
      },
      {
         "id": "testLabel",
         "description": "Choose test to run, empty for all ([suite]/[test])",
         "type": "promptString",
      },
   ],
   "configurations": [
      {
         "name": "(gdb) Debug Deepthought Release",
         "type": "cppdbg",
         "request": "launch",
         "program": "${workspaceFolder}/build/RelWithDebInfo/deepthought",
         "args": [
            "-d",
            "${workspaceFolder}/${input:missionName}",
            "-o",
            "${workspaceFolder}/${input:missionName}/blah",
            "-g",
            "0",
         ],
         "stopAtEntry": false,
         "cwd": "${workspaceFolder}",
         "environment": [],
         "externalConsole": false,
         "MIMode": "gdb",
         "preLaunchTask": "relwithdebinfo build",
         "setupCommands": [
            {
               "description": "Enable pretty-printing for gdb",
               "text": "-enable-pretty-printing",
               "ignoreFailures": true
            },
            {
               "description": "Set Disassembly Flavor to Intel",
               "text": "-gdb-set disassembly-flavor intel",
               "ignoreFailures": true
            }
         ]
      },
      {
         "name": "(gdb) Debug Deepthought",
         "type": "cppdbg",
         "request": "launch",
         "program": "${workspaceFolder}/build/Debug/deepthought",
         "args": [
            "-d",
            "${workspaceFolder}/${input:missionName}/",
            "-o",
            "${workspaceFolder}/${input:missionName}/blah",
            "-g",
            "0"
         ],
         "stopAtEntry": false,
         "cwd": "${workspaceFolder}",
         "environment": [],
         "MIMode": "gdb",
         "preLaunchTask": "debug build",
         "setupCommands": [
            {
               "description": "Enable pretty-printing for gdb",
               "text": "-enable-pretty-printing",
               "ignoreFailures": true
            },
            {
               "description": "Set Disassembly Flavor to Intel",
               "text": "-gdb-set disassembly-flavor intel",
               "ignoreFailures": true
            }
         ]
      },
      {
         "name": "(gdb) Debug Deepthought Arbitrary",
         "type": "cppdbg",
         "request": "launch",
         "program": "${workspaceFolder}/build/Debug/deepthought",
         "args": [
            "-d",
            "${input:arbitraryMission}/",
            "-o",
            "${input:arbitraryMission}/blah",
            "-g",
            "1"
         ],
         "stopAtEntry": false,
         "cwd": "${workspaceFolder}",
         "environment": [],
         "MIMode": "gdb",
         "preLaunchTask": "debug build",
         "setupCommands": [
            {
               "description": "Enable pretty-printing for gdb",
               "text": "-enable-pretty-printing",
               "ignoreFailures": true
            },
            {
               "description": "Set Disassembly Flavor to Intel",
               "text": "-gdb-set disassembly-flavor intel",
               "ignoreFailures": true
            }
         ]
      },
      {
         "name": "(gdb) Debug Attach to Criterion test",
         "type": "cppdbg",
         "request": "launch",
         "cwd": "${workspaceFolder}",
         "program": "${workspaceFolder}/build/Debug/${input:testTarget}",
         "miDebuggerServerAddress": "localhost:1234",
         "miDebuggerPath": "/usr/bin/gdb",
         "MIMode": "gdb",
         "setupCommands": [
            {
               "description": "Enable pretty-printing for gdb",
               "text": "-enable-pretty-printing",
               "ignoreFailures": true
            },
         ]
      },
      {
         "name": "(gdb) Start Criterion test",
         "type": "cppdbg",
         "request": "launch",
         "cwd": "${workspaceFolder}",
         "program": "${workspaceFolder}/build/Debug/${input:testTarget}",
         "miDebuggerServerAddress": "localhost:1234",
         "miDebuggerPath": "/usr/bin/gdb",
         "MIMode": "gdb",
         "preLaunchTask": "build and start criterion test",
         "setupCommands": [
            {
               "description": "Enable pretty-printing for gdb",
               "text": "-enable-pretty-printing",
               "ignoreFailures": true
            },
         ]
      },
