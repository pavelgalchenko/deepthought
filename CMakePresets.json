{
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 19
    },
    "configurePresets": [
        {
            "name": "default_debug",
            "displayName": "Default Debug configure preset",
            "description": "Sets Make generator, build, and install directory for debug build.",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "DEBUG_DATA": "OFF",
                "SPICE": "ON",
                "GUI": "ON",
                "SANITIZER": "OFF",
                "PROFILE": "OFF"
            }
        },
        {
            "name": "default_release",
            "inherits": "default_debug",
            "displayName": "Default Release configure preset",
            "description": "Sets Make generator, build, and install directory for release build",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "profile_release",
            "inherits": "default_debug",
            "displayName": "Default Release configure preset",
            "description": "Sets Make generator, build, and install directory for release build",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "PROFILE": "ON"
            }
        }
    ]
}