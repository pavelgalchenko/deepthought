{
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 19
    },
    "configurePresets": [
        {
            "name": "Debug",
            "displayName": "Debug configure preset",
            "description": "Sets Make generator, build, and install directory for debug build.",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_BUILD_TYPE": "Debug",
                "DEBUG_DATA": "OFF",
                "SPICE": "ON",
                "GUI": "ON",
                "SANITIZER": "OFF",
                "PROFILE": "OFF"
            }
        },
        {
            "name": "Release",
            "inherits": "Debug",
            "displayName": "Release configure preset",
            "description": "Sets Make generator, build, and install directory for release build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "RelWithDebInfo",
            "inherits": "Debug",
            "displayName": "RelWithDebInfo configure preset",
            "description": "Sets Make generator, build, and install directory for release build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "Profile_Release",
            "inherits": "Release",
            "displayName": "Profile Release configure preset",
            "description": "Sets Make generator, build, and install directory for release build with profiling",
            "cacheVariables": {
                "PROFILE": "ON"
            }
        },
        {
            "name": "Profile_Debug",
            "inherits": "Debug",
            "displayName": "Profile Debug configure preset",
            "description": "Sets Make generator, build, and install directory for release build with profiling",
            "cacheVariables": {
                "PROFILE": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug-build",
            "configurePreset": "Debug",
            "jobs": 0
        },
        {
            "name": "RelWithDebInfo-build",
            "configurePreset": "RelWithDebInfo",
            "inherits": [
                "Debug-build"
            ]
        },
        {
            "name": "Release-build",
            "configurePreset": "Release",
            "inherits": [
                "Debug-build"
            ]
        },
        {
            "name": "Profile_Release-build",
            "configurePreset": "Profile_Release",
            "inherits": [
                "Debug-build"
            ]
        },
        {
            "name": "Profile_Debug-build",
            "configurePreset": "Profile_Debug",
            "inherits": [
                "Debug-build"
            ]
        }
    ],
    "testPresets": [
        {
            "name": "test-Debug",
            "configurePreset": "Debug",
            "description": "Runs all tests for the debug build",
            "execution": {
                "jobs": 0
            }
        },
        {
            "name": "test-Release",
            "configurePreset": "Release",
            "description": "Runs all tests for the release build",
            "execution": {
                "jobs": 0
            }
        }
    ],
    "workflowPresets": [
        {
            "name": "build-Debug",
            "steps": [
                {
                    "type": "configure",
                    "name": "Debug"
                },
                {
                    "type": "build",
                    "name": "Debug-build"
                }
            ]
        },
        {
            "name": "build-Release",
            "steps": [
                {
                    "type": "configure",
                    "name": "Release"
                },
                {
                    "type": "build",
                    "name": "Release-build"
                }
            ]
        },
        {
            "name": "build-RelWithDebInfo",
            "steps": [
                {
                    "type": "configure",
                    "name": "RelWithDebInfo"
                },
                {
                    "type": "build",
                    "name": "RelWithDebInfo-build"
                }
            ]
        },
        {
            "name": "build-Profile_Release",
            "steps": [
                {
                    "type": "configure",
                    "name": "Profile_Release"
                },
                {
                    "type": "build",
                    "name": "Profile_Release-build"
                }
            ]
        },
        {
            "name": "build-Profile_Debug",
            "steps": [
                {
                    "type": "configure",
                    "name": "Profile_Debug"
                },
                {
                    "type": "build",
                    "name": "Profile_Debug-build"
                }
            ]
        },
        {
            "name": "test-Debug",
            "steps": [
                {
                    "type": "configure",
                    "name": "Debug"
                },
                {
                    "type": "build",
                    "name": "Debug-build"
                },
                {
                    "type": "test",
                    "name": "test-Debug"
                }
            ]
        },
        {
            "name": "test-Release",
            "steps": [
                {
                    "type": "configure",
                    "name": "Release"
                },
                {
                    "type": "build",
                    "name": "Release-build"
                },
                {
                    "type": "test",
                    "name": "test-Release"
                }
            ]
        }
    ]
}